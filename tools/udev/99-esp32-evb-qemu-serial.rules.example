# Stable alias for the ESP32-EVB CH340 USB-serial adapter passed through
# from the host via USB device passthrough.
# Copy to /etc/udev/rules.d/99-esp32-evb-qemu-serial.rules, then:
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=tty
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="esp32-evb"
